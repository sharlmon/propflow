# Copy to .env for Docker Compose. These values are development-only.
POSTGRES_DB=propflow
POSTGRES_USER=propflow
POSTGRES_PASSWORD=propflow_dev_only
DATABASE_URL=postgres://propflow:propflow_dev_only@db:5432/propflow?sslmode=disable
TEST_DATABASE_URL=postgres://propflow:propflow_test_only@test-db:5432/propflow_test?sslmode=disable
APP_ENV=development
HTTP_ADDR=:8080
APP_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
SESSION_TTL=24h
VITE_API_BASE_URL=/api/v1
MINIO_ROOT_USER=propflow_local
MINIO_ROOT_PASSWORD=propflow_local_only_change_me
S3_ENDPOINT=http://minio:9000
S3_BUCKET=propflow-media
